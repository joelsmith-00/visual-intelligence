# Copy to backend/.env or set these in your host (Render, etc.)
ADMIN_KEY=choose-a-long-random-secret
# Leave unset to use local SQLite. For Supabase/Postgres:
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxx.supabase.co:5432/postgres
# Your public site URL (used inside the QR codes):
# PUBLIC_URL=https://your-site.onrender.com
TEAM_MIN=4
TEAM_MAX=5
